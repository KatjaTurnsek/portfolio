<div
  class='fullscreen-menu'
  id='menu'
  role='dialog'
  aria-modal='true'
  aria-labelledby='menu-title'
  tabindex='-1'
  inert
>
  <span id='menu-title' class='visually-hidden'>Main menu</span>

  <a href='{{base}}' aria-label='Go to home'>
    <img
      src='{{base}}assets/images/logo-katjadev-dark.svg'
      data-logo-light='{{base}}assets/images/logo-katjadev-light.svg'
      data-logo-dark='{{base}}assets/images/logo-katjadev-dark.svg'
      alt='Katja Dev Logo'
      class='site-logo logo'
      loading='eager'
      decoding='async'
    />
  </a>

  <button class='menu-toggle opened' id='menuClose' aria-label='Close menu'>
    <svg class='icon' aria-hidden='true'>
      <use href='#i-close' />
    </svg>
  </button>

  <nav aria-label='Primary'>
    <a href='{{base}}#work'>Work</a>
    <a href='{{base}}#about'>About</a>
    <a href='{{base}}#contact'>Contact</a>
  </nav>
</div>