        <h1 id='case-logina-title'>
          Logina - Selected Professional Work
        </h1>

        <p class='case-subtitle'>
          Touchscreen interfaces, product communication, illustration, character design, and
          animation created while working as a designer at Logina.
        </p>

        <dl class='case-summary' aria-label='Project summary'>
          <div>
            <dt>Role</dt>
            <dd>Designer</dd>
          </div>

          <div>
            <dt>Company</dt>
            <dd>Logina IT d.o.o.</dd>
          </div>

          <div>
            <dt>Scope</dt>
            <dd>Touchscreen UI, print, packaging, illustration, and animation</dd>
          </div>

          <div>
            <dt>Tools</dt>
            <dd>CorelDRAW, Photoshop, Flash, Premiere, and Logina software</dd>
          </div>

          <div>
            <dt>Context</dt>
            <dd>Commercial design work from the early 2000s</dd>
          </div>
        </dl>
