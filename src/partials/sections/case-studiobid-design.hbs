        <h1 id='case-studiobid-design-title'>StudioBid</h1>
        <p class='case-subtitle'>
          An auction platform designed to make changing prices, deadlines, and bidding decisions
          easier to understand.
        </p>

        <dl class='case-summary' aria-label='Project summary'>
          <div>
            <dt>Role</dt>
            <dd>UX/UI design and prototyping</dd>
          </div>
          <div>
            <dt>Scope</dt>
            <dd>Individual Semester Project 2</dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>2025</dd>
          </div>
          <div>
            <dt>Tools</dt>
            <dd>Figma, wireframing, responsive UI, component system</dd>
          </div>
          <div>
            <dt>Outcome</dt>
            <dd>Complete auction journey</dd>
          </div>
        </dl>

        <div class='tech-demo-wrapper case-demo-wrapper'>
          <div class='demo-links' data-auto='demo' data-case='studiobid-design'></div>
        </div>

        <nav
          class='project-switcher'
          aria-label='StudioBid sections'
          data-auto='switcher'
          data-case='studiobid'
