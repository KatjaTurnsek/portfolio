<section
  class='fullscreen-section'
  id='contact'
  data-title='Contact — Katja Turnsek | UX/UI Designer & Front-End Developer'
  data-description='Contact Katja Turnsek about UX/UI design, front-end development, freelance projects, agency collaborations, or suitable roles.'
>
  <div class='rows'>
    <div class='row'>
      <h1>Contact</h1>
      <h2>Have a project or opportunity in mind?</h2>

      <p class='align-right-60'>
        If you need help with a website, digital product, or visual identity or you’re looking for
        someone who can work across both
        <strong>design and front-end development</strong>, tell me a little about what you have in
        mind.
      </p>
    </div>

    <div class='row'>
      <h3>Ways We Can Work Together</h3>
      <p>
        I’m available for
        <strong>selected freelance projects</strong>,
        <strong>agency collaborations</strong>, and suitable
        <strong>design or front-end roles</strong>. I’m based in Slovenia and can work with clients
        and teams in Slovenia, Sweden, and remotely across Europe.
      </p>

      <p class='info-text'>
        Email me at
        <a
          id='contact-email'
          href='mailto:katja@pet-art.net'
          rel='nofollow noopener'
        >katja@pet-art.net</a>
        or send a message using the form.
      </p>

      <div class='contact-form-wrapper'>
        <form
          action='https://api.web3forms.com/submit'
          method='POST'
          class='contact-form'
          aria-label='Contact form'
          data-contact-form
        >
          <!-- Required: Web3Forms access key -->
          <input type='hidden' name='access_key' value='4b70fb1f-a7f2-4100-8a21-d9e9d5dfd983' />

          <!-- Subject, branding & redirect -->
          <input type='hidden' name='subject' value='Portfolio — New message' />
          <input type='hidden' name='from_name' value='Portfolio Contact' />

          <input
            type='hidden'
            name='redirect'
            value='https://katjaturnsek.github.io/portfolio/#thank-you'
          />

          <input
            type='hidden'
            name='page_url'
            value='https://katjaturnsek.github.io/portfolio/#contact'
          />

          <!-- Honeypot: must remain empty -->
          <div style='position: absolute; left: -9999px; opacity: 0; pointer-events: none;'>
            <label for='botcheck' class='sr-only'>Leave this field empty</label>
            <input
              id='botcheck'
              type='checkbox'
              name='botcheck'
              tabindex='-1'
              autocomplete='off'
              aria-label='Leave this field empty'
            />
          </div>

          <div class='name-row'>
            <div class='form-group'>
              <label for='name'>Your name *</label>
              <input id='name' name='name' type='text' required autocomplete='name' />
            </div>

            <div class='form-group'>
              <label for='email'>Email address *</label>
              <input id='email' name='email' type='email' required autocomplete='email' />
            </div>
          </div>

          <div class='form-group full-width'>
            <label for='company-project'>Company or project (optional)</label>
            <input
              id='company-project'
              name='company_or_project'
              type='text'
              autocomplete='organization'
            />
          </div>

          <div class='form-group full-width'>
            <label for='message'>Tell me a little about your project or opportunity *</label>
            <textarea id='message' name='message' rows='4' required></textarea>
          </div>

          <div class='button-wrapper'>
            <button type='submit' class='submit-button'>
              <span class='submit-button-label'>Send message</span>
              <svg class='icon icon-18 arrow-icon' aria-hidden='true'>
                <use href='#i-arrow-right'></use>
              </svg>
            </button>
          </div>

          <p
            id='contact-form-status'
            class='form-status'
            role='status'
            aria-live='polite'
            aria-atomic='true'
            hidden
          ></p>
        </form>
      </div>
    </div>
  </div>
</section>