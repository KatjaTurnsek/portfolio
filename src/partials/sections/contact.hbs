<section
  class='fullscreen-section'
  id='contact'
  data-title='Contact — Katja Turnsek | UX/UI Designer & Front-End Developer'
  data-description='Get in touch with Katja Turnsek about UX/UI design, front-end development, freelance projects, or opportunities to join your team.'
>
  <div class='rows'>
    <div class='row'>
      <h1>Contact</h1>
      <h2>Let’s turn a good idea into something real.</h2>

      <p class='align-right-60'>
        Whether you’re looking for a
        <strong>UX/UI designer and front-end developer</strong>
        to join your team, or need freelance support taking a project from concept to a polished
        interface, I’d love to hear from you.
      </p>
    </div>

    <div class='row'>
      <p class='info-text'>
        Email me at
        <a id='contact-email' href='mailto:katja@pet-art.net' rel='nofollow noopener'>
          katja@pet-art.net
        </a>
        or send a message using the form.
      </p>

      <div class='contact-form-wrapper'>
        <form
          action='https://api.web3forms.com/submit'
          method='POST'
          class='contact-form'
          aria-label='Contact form'
        >
          <!-- Required: Web3Forms access key -->
          <input type='hidden' name='access_key' value='4b70fb1f-a7f2-4100-8a21-d9e9d5dfd983' />

          <!-- Subject, branding & redirect -->
          <input type='hidden' name='subject' value='Portfolio — New message' />
          <input type='hidden' name='from_name' value='Portfolio Contact' />

          <input
            type='hidden'
            name='redirect'
            value='https://katjaturnsek.github.io/portfolio/#thank-you'
          />

          <input
            type='hidden'
            name='page_url'
            value='https://katjaturnsek.github.io/portfolio/#contact'
          />

          <!-- Honeypot: must remain empty -->
          <div style='position: absolute; left: -9999px; opacity: 0; pointer-events: none;'>
            <label for='botcheck' class='sr-only'>Leave this field empty</label>
            <input
              id='botcheck'
              type='checkbox'
              name='botcheck'
              tabindex='-1'
              autocomplete='off'
              aria-label='Leave this field empty'
            />
          </div>

          <div class='name-row'>
            <div class='form-group'>
              <label for='name'>Your name *</label>
              <input id='name' name='name' type='text' required autocomplete='name' />
            </div>

            <div class='form-group'>
              <label for='email'>Email address *</label>
              <input id='email' name='email' type='email' required autocomplete='email' />
            </div>
          </div>

          <div class='form-group full-width'>
            <label for='message'>Your message *</label>
            <textarea id='message' name='message' rows='4' required></textarea>
          </div>

          <div class='button-wrapper'>
            <button type='submit' class='submit-button'>
              Send message
              <svg class='icon icon-18 arrow-icon' aria-hidden='true'>
                <use href='#i-arrow-right'></use>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>