<section
  class='fullscreen-section'
  id='work'
  data-title='Work — Featured Projects | Katja Turnsek'
  data-description='Selected case studies across web development, interaction design, and branding by front-end developer & designer Katja Turnsek.'
>
  <div class='rows'>
    <div class='row'>
      <h1>Work - Featured Projects</h1>
      <h2>Digital &amp; Visual Creations</h2>
    </div>

    <!-- Web Development -->
    <section class='work-category' aria-labelledby='web-development-heading'>
      <div class='section-label-left'>
        <h3 id='web-development-heading'>1. Web Development</h3>
      </div>
      <div class='work-columns' id='dev-cards'></div>
    </section>

    <!-- Web & Interaction Design -->
    <section class='work-category' aria-labelledby='interaction-design-heading'>
      <div class='section-label-right'>
        <h3 id='interaction-design-heading'>2. Web &amp; Interaction Design</h3>
      </div>
      <div class='work-columns' id='design-cards'></div>
    </section>

    <!-- Graphic Design -->
    <section class='work-category' aria-labelledby='graphic-design-heading'>
      <div class='section-label-left'>
        <h3 id='graphic-design-heading'>3. Graphic Design</h3>
      </div>
      <div class='work-columns' id='logo-cards'></div>
    </section>

    <div class='back-to-work-container'>
      <a
        href='{{base}}'
        class='label-link back-to-work-label'
        data-back
        data-back-fallback='{{base}}'
        aria-label='Go back'
      >
        <svg class='icon icon-18 arrow-icon' aria-hidden='true'><use href='#i-arrow-left' /></svg>
        <span class='label-text'>Back to Home</span>
      </a>
    </div>
  </div>
</section>